# Free by default with no Docker, no API keys, and no account signup: LLM
# reasoning runs on a local Ollama server, embeddings + reranking run on
# local sentence-transformers, vector storage is an embedded (serverless)
# Qdrant, and agent traces are structured local JSON logs. Just:
#   ollama pull llama3.2:latest
#   python setup.py && python run.py
# Switch to LLM_PROVIDER=huggingface and set HF_API_TOKEN for better quality
# responses (a free HF account gets you a larger judge/agent model without
# using local RAM/GPU).

# === LLM provider ===
# "ollama" (default, free, fully local, no account/API key — requires enough
# RAM to load the model), "huggingface" (free with an HF account, no local
# RAM/GPU needed, better quality), or "mistral" (production, requires
# MISTRAL_API_KEY below).
LLM_PROVIDER=ollama

# === Ollama (default — local LLM server, no API key) ===
# Must be running locally with the model pulled: `ollama pull llama3.2:latest`.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest

# === Hugging Face Inference API (optional — switch to LLM_PROVIDER=huggingface and set HF_API_TOKEN for better quality responses) ===
# Get a free token at huggingface.co/settings/tokens
HF_API_TOKEN=  # optional, for HuggingFace provider
HF_MODEL=mistralai/Mistral-7B-Instruct-v0.2

# === Mistral API (optional — only used when LLM_PROVIDER=mistral) ===
# Get a key at https://console.mistral.ai/
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest

# === Qdrant vector database (embedded — no server, no Docker) ===
# Vectors are stored directly in this local folder; created automatically.
QDRANT_MODE=local
QDRANT_LOCAL_PATH=./qdrant_storage
QDRANT_COLLECTION_NAME=cfd_knowledge_base

# === Local embedding + reranking models (sentence-transformers, no API key) ===
# Downloads automatically from Hugging Face on first use and is cached.
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
LLM_TEMPERATURE=0.1

# === Chunking ===
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# === Retrieval ===
TOP_K_RETRIEVAL=10
TOP_K_RERANKED=3

# === Agent control flow ===
MAX_AGENT_ITERATIONS=10
MAX_RETRIEVAL_ATTEMPTS=2
MAX_VALIDATION_RETRIES=1
RETRIEVAL_QUALITY_THRESHOLD=0.5

# === Embedding cache ===
EMBEDDING_CACHE_PATH=data/processed/embedding_cache.json

# === Local agent trace logging (replaces Phoenix/LangSmith) ===
AGENT_TRACES_LOG_PATH=logs/agent_traces.json

# === API server ===
API_HOST=0.0.0.0
API_PORT=8000
# Change these two if 8000/8501 are already in use on your machine.
STREAMLIT_PORT=8501

# === Data locations ===
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
SESSIONS_DB_PATH=data/processed/sessions.json
